ENVIRONMENT=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=/var/log/aura
HEALTH_DISK_PATH=/data
DATABASE_URL=postgresql+asyncpg://aura:${AURA_DB_PASSWORD}@postgres:5432/aura
REDIS_URL=redis://:${AURA_REDIS_PASSWORD}@redis:6379/0
RABBITMQ_URL=amqp://aura:${AURA_RABBITMQ_PASSWORD}@rabbitmq:5672/
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=${AURA_OPENAI_API_KEY}
